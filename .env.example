# ==============================================================================
# Required for Local Preview & Telegram Authentication
# ==============================================================================
# APP_URL: Automatically injected by AI Studio runtime or hosting platform.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Obtained from @BotFather on Telegram. Never prefix with VITE_.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_ADMIN_IDS: Comma-separated numeric Telegram user IDs allowed to run bot admin commands.
TELEGRAM_ADMIN_IDS=""

# ADMIN_PASSCODE: Admin password used to log into /#admin.
ADMIN_PASSCODE=""

# TELEGRAM_BOT_POLLING: Defaults to "true" in local dev and "false" in production.
TELEGRAM_BOT_POLLING="true"

# ==============================================================================
# Production Database & Hosting Variables (Optional in AI Studio local preview)
# Uncomment ONLY when deploying to Render or connecting an external PostgreSQL DB
# ==============================================================================
# PUBLIC_APP_URL="https://your-novavault-app.onrender.com"
# DATABASE_URL="postgresql://user:password@host:5432/novavault?sslmode=require"
# DATABASE_SSL="true"
# SESSION_SECRET=""
# GEMINI_API_KEY=""
